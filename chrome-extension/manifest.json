{
  "manifest_version": 3,
  "name": "CloudTech Quick Access",
  "version": "1.0.0",
  "description": "CloudTechの各コース・講義へワンクリックでアクセスできるChrome拡張機能です。",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
